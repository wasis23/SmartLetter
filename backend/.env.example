# Server Port
PORT=5000

# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=your_database_password
DB_NAME=smart_letter

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_change_in_production

# SMTP Mail Server Configuration (Gmail or other SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_password_here
SMTP_SECURE=false
SMTP_FROM="SmartLetter System" <your_email@domain.com>

# Chrome Path for Puppeteer PDF Generator (Optional, defaults to auto-detect /usr/bin/google-chrome)
# CHROME_PATH=/usr/bin/google-chrome
